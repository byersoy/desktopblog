# Bu dizindeki dosyalar sadece statik olarak sunulur; hicbir script calistirilamaz.
# Yukleme dogrulamasi (Uploader.php) zaten uzanti+MIME kontrolu yapiyor,
# bu dosya sadece ek bir savunma katmanidir.

<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

<FilesMatch "\.(php|phtml|php\d*|pht|phar|cgi|pl|py|sh|asp|aspx)$">
    Require all denied
</FilesMatch>

Options -Indexes -ExecCGI
AddHandler default-handler .php .phtml .pht .phar
